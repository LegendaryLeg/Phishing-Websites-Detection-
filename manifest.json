{
  "manifest_version": 3,
  "name": "Phishing Websites Detection",
  "version": "1.2.0",
  "description": "Local phishing risk scoring with allowlist, lookalike checks, and on-device ML.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing Detector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
