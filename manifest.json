{
  "manifest_version": 3,
  "name": "Phishing Websites Detection",
  "version": "1.0.0",
  "description": "Client-side ML phishing detection for the active browser tab.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing Detector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
